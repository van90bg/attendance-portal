# ============================================================
# Cloud AI Agent - cau hinh (BYOK: ban tu cung cap key)
# Copy file nay sang .env roi dien gia tri. KHONG commit .env
# ============================================================

# --- BAT BUOC: Daytona (sandbox cloud, ban free) ---
# Lay key tai: https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=

# --- BYOK LLM: OpenRouter (mac dinh) ---
# Lay key tai: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model mac dinh (co the doi trong UI luc chay; model :free khong ton phi)
OPENROUTER_MODEL=openrouter/deepseek/deepseek-chat-v3-0324:free

# --- BYOK LLM: NVIDIA (build.nvidia.com - miễn phí, built-in trong OpenCode) ---
# Lay key tai: https://build.nvidia.com (create account -> get API key)
NVIDIA_API_KEY=

# --- BYOK LLM: Kilo AI Gateway (1 key truy cap hang tram model) ---
# Lay key tai: https://app.kil.ai (API Gateway)
KILO_API_KEY=

# --- BYOK LLM: OpenCode Zen (opencode.ai) ---
# Lay key tai: https://opencode.ai/zen (Create API Key)
OPENCODE_ZEN_API_KEY=

# --- Neu can provider khac (Anthropic/OpenAI/Gemini/Groq...) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# --- GitHub (khuyen nghi): repo ban muon sua tu xa ---
# Fine-grained PAT chi cap quyen repo do: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
# Vi du: van90bg/RollCall_2_deploy
GITHUB_REPO=

# --- Tuy chon ---
GIT_USER_NAME=Cloud Agent
GIT_USER_EMAIL=agent@daytona.local
# Daytona region (mac dinh OK; tuy chon: us / eu / ap...)
# DAYTONA_REGION=

# --- Sandbox spec & thoi gian song (tuy chon) ---
# Gioi han theo tier cua ban: xem https://app.daytona.io/dashboard/limits
# Spec cao co the can enable billing (PAYG) o dashboard
SANDBOX_CPU=2
SANDBOX_MEMORY_GB=4
SANDBOX_DISK_GB=10
# Image dung khi co custom spec (Node image chinh thuc: co san node npm git).
# Bo trong -> node:lts-bookworm
# SANDBOX_IMAGE=node:lts-bookworm
# Auto-stop khi khong hoat dong (phut). 0 = vo han (can billing, ton quota)
# Mac dinh cua Daytona la 15 phut
SANDBOX_AUTOSTOP_MINUTES=240
# Auto-delete: am (-1) = KHONG BAO GIO tu xoa. 0 = xoa ngay khi stop. So duong = xoa sau X phut stop
SANDBOX_AUTODELETE_MINUTES=-1
# 1 = giu sandbox khi Ctrl+C (khong xoa) - dung khi muon bo may nha, lam viec tu dien thoai
# Xem them: README muc "Chay khong can may nha"
SANDBOX_KEEP=0